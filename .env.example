# ============================================================
# NovaStore configuration
# 1. Copy this file:  copy .env.example .env   (Windows)
# 2. Fill in the values below.
# 3. NEVER commit .env to Git - it is already in .gitignore.
# ============================================================

# --- LLM provider (Groq) -------------------------------------
# Get a free key at https://console.groq.com -> "API Keys"
GROQ_API_KEY=paste-your-groq-key-here

# Which model to use. Valid examples (verify with `python scripts/list_models.py`):
#   openai/gpt-oss-120b        <- featured default, good JSON + tool use
#   llama-3.3-70b-versatile    <- strong general model (paid tiers)
#   llama-3.1-8b-instant       <- fastest / cheapest
#   openai/gpt-oss-20b         <- smaller, very fast
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1

# Set to true to run the WHOLE app offline with a rule-based MockLLM
# (no API key needed - useful for tests and demos on a plane).
USE_MOCK_LLM=false

# --- Storage -------------------------------------------------
DB_PATH=data/novastore.db
KNOWLEDGE_DIR=data/knowledge

# --- Retrieval (RAG) -----------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.05

# --- Agent confidence thresholds ------------------------------
# Below this, ask a clarifying question instead of guessing.
CONFIDENCE_CLARIFY_BELOW=0.45
# Below this, offer a human handoff instead of answering.
CONFIDENCE_HANDOFF_BELOW=0.25

# --- HTTP server ---------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Streamlit apps ------------------------------------------
# URL where the Streamlit UIs find the FastAPI backend.
UI_API_URL=http://127.0.0.1:8000

# --- WhatsApp (FUTURE - stub only, see docs/whatsapp.md) ------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
